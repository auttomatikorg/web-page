---
import { Icon } from "astro-icon/components";
import type { Locale } from "@/config/site";
import { LANGUAGES, LOCALES, ROUTES, type PageKey } from "@/i18n/utils";

interface Props {
  lang: Locale;
  pageKey: PageKey;
  class?: string;
}
const { lang, pageKey, class: className = "" } = Astro.props;
const current = LANGUAGES[lang];
const shortLabel = lang.toUpperCase();
---

<details class={`lang-switcher relative ${className}`}>
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium text-ink/80 transition-colors hover:text-ink focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary"
    aria-label={current.label}
  >
    <Icon name="lucide:globe" class="h-4 w-4" />
    <span>{shortLabel}</span>
    <Icon name="lucide:chevron-down" class="h-3.5 w-3.5 opacity-60" />
  </summary>
  <ul
    class="absolute right-0 z-50 mt-2 min-w-[9rem] overflow-hidden rounded-xl bg-white py-1 shadow-lg ring-1 ring-ink/10"
  >
    {
      LOCALES.map((loc) => (
        <li>
          <a
            href={ROUTES[pageKey][loc]}
            hreflang={loc}
            class={`flex items-center justify-between px-4 py-2 text-sm transition-colors hover:bg-cream ${
              loc === lang ? "font-semibold text-primary" : "text-ink"
            }`}
            aria-current={loc === lang ? "true" : undefined}
          >
            {LANGUAGES[loc].label}
            <span class="text-xs text-ink-mute">{loc.toUpperCase()}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  /* Hide the default disclosure triangle */
  .lang-switcher summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Close any open language switcher when clicking outside or pressing Escape.
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".lang-switcher[open]").forEach((el) => {
      if (!el.contains(e.target as Node)) el.open = false;
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document
        .querySelectorAll<HTMLDetailsElement>(".lang-switcher[open]")
        .forEach((el) => (el.open = false));
    }
  });
</script>
