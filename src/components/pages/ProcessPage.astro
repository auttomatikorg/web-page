---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PillButton from "@/components/PillButton.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/config/site";
import type { Locale } from "@/config/site";
import { getSlides } from "@/i18n/content/slides";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = getSlides(lang).process;

const ui = {
  es: {
    objective: "Objetivo",
    duration: "Duración orientativa",
    result: "Resultado",
    what: "Qué hacemos",
    flip: "Girar tarjeta",
    back: "Volver",
    action: "Toma acción ya",
    clients: "Algunas de las empresas con las que hemos trabajado",
  },
  ca: {
    objective: "Objectiu",
    duration: "Durada orientativa",
    result: "Resultat",
    what: "Què fem",
    flip: "Girar targeta",
    back: "Tornar",
    action: "Actua ara",
    clients: "Empreses amb les quals hem treballat",
  },
  en: {
    objective: "Objective",
    duration: "Estimated time",
    result: "Outcome",
    what: "What we do",
    flip: "Flip card",
    back: "Back",
    action: "Take action now",
    clients: "Companies we have worked with",
  },
} as const;

const t = ui[lang];
const clients = [
  {
    name: "Doctomatic",
    href: "https://www.doctomatic.com/",
    logo: "/images/clients/doctomatic.svg",
  },
  {
    name: "Driveme Renting",
    href: "https://www.drivemebarcelona.com/",
    logo: "https://www.google.com/s2/favicons?domain=drivemebarcelona.com&sz=128",
  },
  {
    name: "Dermilid",
    href: "https://dermilid.com/",
    logo: "https://www.google.com/s2/favicons?domain=dermilid.com&sz=128",
  },
  {
    name: "Valorix",
    href: "https://www.valorixloan.es/es/",
    logo: "https://www.google.com/s2/favicons?domain=valorixloan.es&sz=128",
  },
  {
    name: "Tectum",
    href: "https://www.tectumdomus.com/index.html",
    logo: "/images/clients/tectum.svg",
  },
  {
    name: "Hogava",
    href: "https://www.hogava.com/",
    logo: "/images/clients/hogava.svg",
  },
  {
    name: "Grantial",
    href: "https://grantial.com/",
    logo: "/images/clients/grantial.svg",
  },
];
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  pageKey="process"
>
  <section class="process-page" aria-labelledby="process-title">
    <header class="process-hero enter" style="--delay:80ms">
      <p class="micro process-eyebrow">{c.eyebrow.join(" ")}</p>
      <div class="process-copy">
        <h1 id="process-title" class="process-title">{c.title}</h1>
      </div>
    </header>

    <ol class="process-grid" aria-label={c.title}>
      {
        c.phases.map((phase, i) => (
          <li class="enter process-card" style={`--delay:${220 + i * 110}ms`}>
            <article class="flip-card" data-flip-card>
              <div class="flip-card-inner">
                <div class="flip-card-face flip-card-front">
                  <div class="phase-card-top">
                    <span class="phase-badge">{phase.n}</span>
                    <button
                      type="button"
                      class="phase-flip"
                      data-flip-button
                      aria-pressed="false"
                      aria-label={t.flip}
                    >
                      <Icon name="lucide:rotate-cw" class="h-4 w-4" aria-hidden="true" />
                      <span>{t.flip}</span>
                    </button>
                  </div>

                  <h2 class="phase-title">{phase.title}</h2>

                  <dl class="phase-meta">
                    <div>
                      <dt>{t.objective}</dt>
                      <dd>{phase.objective}</dd>
                    </div>
                    <div>
                      <dt>{t.duration}</dt>
                      <dd>{phase.duration}</dd>
                    </div>
                    <div class="phase-result-block">
                      <dt>{t.result}</dt>
                      <dd>{phase.result}</dd>
                    </div>
                  </dl>
                </div>

                <div class="flip-card-face flip-card-back">
                  <div class="phase-card-top">
                    <span class="phase-badge phase-badge-soft">{t.what}</span>
                    <button
                      type="button"
                      class="phase-flip"
                      data-flip-button
                      aria-pressed="true"
                      aria-label={t.back}
                    >
                      <Icon name="lucide:rotate-ccw" class="h-4 w-4" aria-hidden="true" />
                      <span>{t.back}</span>
                    </button>
                  </div>

                  <h2 class="phase-title">{phase.title}</h2>

                  <ul class="phase-checklist">
                    {phase.checklist.map((item) => (
                      <li>
                        <Icon name="lucide:check" class="h-4 w-4" aria-hidden="true" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="phase-back-action">
                    <PillButton
                      href={SITE.booking.bookingUrl}
                      variant="solid"
                      size="md"
                      external
                    >
                      {t.action}
                    </PillButton>
                  </div>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    <section class="process-clients enter" style="--delay:570ms" aria-label={t.clients}>
      <p class="micro process-clients-label">{t.clients}</p>
      <div class="process-client-row">
        {
          clients.map((client) => (
            <a
              href={client.href}
              target="_blank"
              rel="noopener noreferrer"
              class="process-client"
              aria-label={client.name}
            >
              <img src={client.logo} alt="" loading="lazy" decoding="async" />
              <span>{client.name}</span>
            </a>
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  type FlipCard = HTMLElement & {
    __auttomatikFlipCleanup?: () => void;
  };

  const setupProcessCards = () => {
    const cards = document.querySelectorAll<FlipCard>("[data-flip-card]");

    cards.forEach((card) => {
      if (card.dataset.flipReady === "true") return;

      card.__auttomatikFlipCleanup?.();
      card.dataset.flipReady = "true";

      const buttons = card.querySelectorAll<HTMLButtonElement>("[data-flip-button]");
      const controller = new AbortController();

      const setFlipped = (flipped: boolean) => {
        card.classList.toggle("is-flipped", flipped);
        buttons.forEach((button) => {
          button.setAttribute("aria-pressed", String(flipped));
        });
      };

      buttons.forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            setFlipped(!card.classList.contains("is-flipped"));
          },
          { signal: controller.signal },
        );
      });

      const cleanup = () => {
        controller.abort();
        delete card.dataset.flipReady;
        delete card.__auttomatikFlipCleanup;
      };

      card.__auttomatikFlipCleanup = cleanup;
      document.addEventListener("astro:before-swap", cleanup, { once: true });
    });
  };

  const processWindow = window as Window & {
    __auttomatikProcessCardsBound?: boolean;
  };

  if (!processWindow.__auttomatikProcessCardsBound) {
    processWindow.__auttomatikProcessCardsBound = true;
    document.addEventListener("astro:page-load", setupProcessCards);
  }

  setupProcessCards();
</script>
