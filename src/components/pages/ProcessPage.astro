---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ClosingCta from "@/components/sections/ClosingCta.astro";
import { Icon } from "astro-icon/components";
import type { Locale } from "@/config/site";
import { getProcess } from "@/i18n/content/process";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = getProcess(lang);
const carouselLabels = {
  es: {
    previous: "Fase anterior",
    next: "Fase siguiente",
  },
  ca: {
    previous: "Fase anterior",
    next: "Fase següent",
  },
  en: {
    previous: "Previous phase",
    next: "Next phase",
  },
} as const;
const labels = carouselLabels[lang];
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  pageKey="process"
>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} intro={c.hero.intro} />

  <Section tone="cream">
    <div class="relative md:hidden">
      <button
        type="button"
        class="absolute left-0 top-1/2 z-10 flex h-10 w-10 -translate-x-2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-primary shadow-md ring-1 ring-ink/10 transition-colors hover:bg-cream-soft focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label={labels.previous}
        data-process-prev
      >
        <Icon name="lucide:chevron-left" class="h-6 w-6" />
      </button>

      <ol
        class="scrollbar-none flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-4 pb-2"
        data-process-carousel
      >
        {
          c.phases.map((phase, i) => (
            <li class="reveal w-[min(82vw,22rem)] shrink-0 snap-center rounded-3xl bg-white p-6 ring-1 ring-ink/10">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary text-lg font-semibold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </div>

              <h2 class="mt-5 text-2xl font-semibold text-ink">
                {phase.title}
              </h2>
              <p class="mt-3 leading-relaxed text-ink-soft">
                <span class="font-medium text-ink">{c.labels.objective}: </span>
                {phase.objective}
              </p>

              <div class="mt-6 space-y-5">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-primary">
                    {c.labels.activities}
                  </p>
                  <ul class="mt-2 space-y-2">
                    {phase.activities.map((a) => (
                      <li class="flex items-start gap-2 text-sm leading-relaxed text-ink-soft">
                        <Icon
                          name="lucide:check"
                          class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                        />
                        {a}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="rounded-2xl bg-cream-soft p-4 ring-1 ring-ink/5">
                  <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary">
                    <Icon name="lucide:clock" class="h-4 w-4" />
                    {c.labels.duration}
                  </p>
                  <p class="mt-1 font-medium text-ink">{phase.duration}</p>
                </div>

                <div class="rounded-2xl bg-primary/10 p-4">
                  <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary">
                    <Icon name="lucide:sparkles" class="h-4 w-4" />
                    {c.labels.result}
                  </p>
                  <p class="mt-1 font-medium text-ink">{phase.result}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <button
        type="button"
        class="absolute right-0 top-1/2 z-10 flex h-10 w-10 translate-x-2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-primary shadow-md ring-1 ring-ink/10 transition-colors hover:bg-cream-soft focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-label={labels.next}
        data-process-next
      >
        <Icon name="lucide:chevron-right" class="h-6 w-6" />
      </button>
    </div>

    <ol class="hidden space-y-6 md:block">
      {
        c.phases.map((phase, i) => (
          <li class="reveal rounded-3xl bg-white p-7 ring-1 ring-ink/10 md:p-10">
            <div class="grid gap-8 lg:grid-cols-[auto_1fr]">
              <div
                class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-xl font-semibold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </div>

              <div>
                <h2 class="text-2xl font-semibold text-ink md:text-3xl">
                  {phase.title}
                </h2>
                <p class="mt-3 text-lg leading-relaxed text-ink-soft">
                  <span class="font-medium text-ink">{c.labels.objective}: </span>
                  {phase.objective}
                </p>

                <div class="mt-6 grid gap-6 md:grid-cols-2">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-primary">
                      {c.labels.activities}
                    </p>
                    <ul class="mt-2 space-y-2">
                      {phase.activities.map((a) => (
                        <li class="flex items-start gap-2 text-ink-soft">
                          <Icon
                            name="lucide:check"
                            class="mt-1 h-4 w-4 shrink-0 text-primary"
                          />
                          {a}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="flex flex-col gap-3">
                    <div class="rounded-2xl bg-cream-soft p-5 ring-1 ring-ink/5">
                      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary">
                        <Icon name="lucide:clock" class="h-4 w-4" />
                        {c.labels.duration}
                      </p>
                      <p class="mt-1 font-medium text-ink">{phase.duration}</p>
                    </div>
                    <div class="rounded-2xl bg-primary/10 p-5">
                      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary">
                        <Icon name="lucide:sparkles" class="h-4 w-4" />
                        {c.labels.result}
                      </p>
                      <p class="mt-1 font-medium text-ink">{phase.result}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section tone="white">
    <SectionHeading
      eyebrow=""
      title={c.principles.title}
      intro={c.principles.intro}
      align="center"
      class="mb-12"
    />
    <div class="grid gap-5 md:grid-cols-3">
      {
        c.principles.items.map((item) => (
          <div class="reveal rounded-2xl bg-cream-soft p-6 ring-1 ring-ink/5">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <Icon name={item.icon} class="h-6 w-6" />
            </div>
            <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{item.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <ClosingCta lang={lang} />
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-process-carousel]");
  const previous = document.querySelector<HTMLButtonElement>("[data-process-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-process-next]");

  const scrollPhase = (direction: number) => {
    const firstCard = carousel?.querySelector<HTMLElement>("li");
    const cardWidth = firstCard?.getBoundingClientRect().width ?? 0;
    const gap = 16;
    carousel?.scrollBy({
      left: direction * (cardWidth + gap),
      behavior: "smooth",
    });
  };

  previous?.addEventListener("click", () => scrollPhase(-1));
  next?.addEventListener("click", () => scrollPhase(1));
</script>
