---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ClosingCta from "@/components/sections/ClosingCta.astro";
import { Icon } from "astro-icon/components";
import type { Locale } from "@/config/site";
import { getAbout } from "@/i18n/content/about";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = getAbout(lang);
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  pageKey="about"
>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} intro={c.hero.intro} />

  <Section tone="white">
    <div class="reveal mx-auto max-w-6xl overflow-hidden rounded-3xl ring-1 ring-ink/10">
      <img
        src="/images/equipo%20Auttomatik.png"
        alt="Equipo de Auttomatik"
        class="h-auto w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>
  </Section>

  <Section tone="cream">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <h2 class="text-3xl font-semibold text-ink md:text-4xl lg:sticky lg:top-28 lg:self-start">
        {c.manifesto.title}
      </h2>
      <div class="space-y-5">
        {
          c.manifesto.paragraphs.map((p, i) => (
            <p
              class={`reveal leading-relaxed text-ink-soft ${i === 0 ? "text-xl text-ink" : "text-lg"}`}
            >
              {p}
            </p>
          ))
        }
      </div>
    </div>
  </Section>

  <Section tone="white" containerClass="[max-width:96rem]">
    <SectionHeading
      title={c.team.title}
      intro={c.team.intro}
      align="center"
      class="mb-12"
    />
    <div class="mx-auto grid w-full gap-4 sm:grid-cols-2 lg:grid-cols-4 xl:gap-6">
      {
        c.team.members.map((member) => {
          const initials = member.name
            .split(" ")
            .map((n) => n[0])
            .join("")
            .slice(0, 2)
            .toUpperCase();
          return (
            <div class="reveal flex h-full flex-col rounded-2xl bg-cream-soft p-7 ring-1 ring-ink/5 lg:grid lg:grid-rows-[5rem_9rem_1fr_auto]">
              <div class="flex items-start gap-4">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/15 text-lg font-semibold text-primary">
                  {initials}
                </span>
                <div class="min-w-0">
                  <h3 class="text-xl font-semibold text-ink">{member.name}</h3>
                  <p class="text-sm font-medium text-primary">{member.role}</p>
                </div>
              </div>
              <p class="mt-5 leading-relaxed text-ink-soft lg:mt-0">{member.bio}</p>
              <div class="mt-5 space-y-3 lg:mt-0">
                {member.highlights.map((h) => (
                  <div class="rounded-xl bg-white p-4 ring-1 ring-ink/5">
                    <p class="text-sm leading-relaxed text-ink-soft">
                      <span class="font-semibold text-primary">{h.stat}</span> —{" "}
                      {h.text}
                    </p>
                  </div>
                ))}
              </div>
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 self-start rounded-full px-4 py-2 text-sm font-medium text-ink ring-1 ring-ink/15 transition-colors hover:bg-ink/5 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary lg:mt-6"
                aria-label={`LinkedIn de ${member.name}`}
              >
                <Icon name="lucide:linkedin" class="h-4 w-4 text-primary" />
                LinkedIn
              </a>
            </div>
          );
        })
      }
    </div>
  </Section>

  <ClosingCta lang={lang} />
</BaseLayout>
