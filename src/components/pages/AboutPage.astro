---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PillButton from "@/components/PillButton.astro";
import { Icon } from "astro-icon/components";
import type { Locale } from "@/config/site";
import { getSlides } from "@/i18n/content/slides";
import { route } from "@/i18n/utils";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = getSlides(lang).about;
const ui = {
  es: {
    details: "Ver detalles",
    teamDetails: "Ver detalles del equipo",
    imageAlt: "Equipo de Auttomatik",
  },
  ca: {
    details: "Veure detalls",
    teamDetails: "Veure detalls de l'equip",
    imageAlt: "Equip d'Auttomatik",
  },
  en: {
    details: "View details",
    teamDetails: "View team details",
    imageAlt: "Auttomatik team",
  },
} as const;
const t = ui[lang];
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  pageKey="about"
>
  <section class="about-page" aria-labelledby="about-title">
    <div class="about-copy enter" style="--delay:80ms">
      <p class="micro about-eyebrow">{c.eyebrow.join(" ")}</p>
      <h1 id="about-title" class="about-title">{c.title}</h1>
      <p class="about-intro">{c.intro}</p>

      <div class="about-philosophy">
        <span class="about-philosophy-label">{c.philosophyLabel}</span>
        <p>{c.philosophy}</p>
      </div>

      <ul class="about-kpi-list" aria-label="KPI">
        {c.kpis.map((item) => (
          <li class="about-kpi-item">
            <Icon name="lucide:check" class="h-4 w-4" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <div class="about-cta">
        <PillButton href={route("contact", lang)}>{c.cta}</PillButton>
      </div>
    </div>

    <details class="about-team-panel enter-fade" style="--delay:220ms">
      <summary class="about-team-toggle" aria-label={t.teamDetails}>
        <img
          src="/images/equipo%20Auttomatik.png"
          alt={t.imageAlt}
          class="about-team-image"
          loading="eager"
          decoding="async"
        />
        <span class="about-team-hint">{t.details}</span>
      </summary>

      <div class="about-team-shell">
        <div class="about-team-cards">
          {c.team.map((member) => (
            <article class="about-member-card">
              <div class="about-member-head">
                <div>
                  <h2>{member.name}</h2>
                  <p>{member.role}</p>
                </div>
              </div>
              <p class="about-member-experience">{member.experience}</p>
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="about-linkedin"
              >
                <Icon name="lucide:linkedin" class="h-4 w-4" aria-hidden="true" />
                <span>LinkedIn</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </details>
  </section>
</BaseLayout>
