---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PillButton from "@/components/PillButton.astro";
import { Icon } from "astro-icon/components";
import { SITE, whatsappLink } from "@/config/site";
import type { Locale } from "@/config/site";
import { getSlides } from "@/i18n/content/slides";
import { useTranslations } from "@/i18n/ui";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = getSlides(lang).contact;
const t = useTranslations(lang);

/* Booking opens Cal in a new tab rather than embedding it: the inline widget
   needs ~720px of its own and would break the single-viewport rule. */
const hrefs = [
  SITE.booking.bookingUrl,
  whatsappLink(t("wa.default")),
  `mailto:${SITE.email}`,
];
const icons = ["lucide:calendar-check", "lucide:message-circle", "lucide:mail"];

const channels = c.channels.map((ch, i) => ({
  ...ch,
  href: hrefs[i],
  icon: icons[i],
  note: ch.note || SITE.email,
  external: i < 2,
  featured: i === 0,
}));
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  pageKey="contact"
>
  <div
    class="grid h-full gap-8 pt-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-16 lg:pt-0"
  >
    <div>
      <div class="grid gap-4">
        <p
          class="enter micro text-primary"
          style="--delay:60ms"
        >
          {c.eyebrow.join(" ")}
        </p>
        <h1 class="enter text-hero font-medium" style="--delay:120ms">
          {c.title}
        </h1>
      </div>

      <p class="enter mt-6 max-w-xl text-step text-ink-soft" style="--delay:200ms">
        {c.intro}
      </p>

      <div class="enter mt-8" style="--delay:280ms">
        <PillButton href={SITE.booking.bookingUrl} variant="solid" size="lg" external>
          {c.cta}
        </PillButton>
      </div>
    </div>

    <!-- Every way in, as one glass stack -->
    <div class="enter glass-solid rounded-[1.75rem] p-4" style="--delay:360ms">
      <p class="chip w-full justify-center">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
        </span>
        {c.chip}
      </p>

      <ul class="mt-3 flex flex-col gap-2">
        {
          channels.map((ch) => (
            <li>
              <a
                href={ch.href}
                target={ch.external ? "_blank" : undefined}
                rel={ch.external ? "noopener noreferrer" : undefined}
                class={`group/ch flex items-center gap-4 rounded-2xl border px-4 py-3.5 transition-[background-color,border-color] duration-500 hover:border-primary/25 hover:bg-primary/[0.06] ${
                  ch.featured
                    ? "border-primary/25 bg-primary/[0.06]"
                    : "border-transparent"
                }`}
              >
                <span
                  class={`grid h-10 w-10 shrink-0 place-items-center rounded-full transition-colors duration-500 group-hover/ch:bg-primary group-hover/ch:text-white ${
                    ch.featured
                      ? "bg-primary text-white"
                      : "bg-primary/10 text-primary-ink"
                  }`}
                >
                  <Icon name={ch.icon} class="h-4 w-4" />
                </span>
                <span class="min-w-0">
                  <span class="block font-medium text-ink">{ch.label}</span>
                  <span class="block truncate text-sm text-ink-mute">
                    {ch.note}
                  </span>
                </span>
                <Icon
                  name="lucide:arrow-up-right"
                  class={`ml-auto h-4 w-4 shrink-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/ch:translate-x-0.5 group-hover/ch:-translate-y-0.5 group-hover/ch:text-primary ${
                    ch.featured ? "text-primary" : "text-ink-mute"
                  }`}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
