---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";
import type { Locale } from "@/config/site";
import { getLegal } from "@/i18n/content/legal";
import type { PageKey } from "@/i18n/utils";

interface Props {
  lang: Locale;
  doc: "legal" | "privacy" | "cookies";
}
const { lang, doc } = Astro.props;
const bundle = getLegal(lang);
const content = bundle[doc];
const pageKey = doc as PageKey;

const tokens: Record<string, string> = {
  "{company}": SITE.legal.companyName,
  "{taxId}": SITE.legal.taxId,
  "{address}": SITE.legal.address,
  "{email}": SITE.email,
  "{url}": SITE.url,
};

function fill(text: string): string {
  return text.replace(/\{company\}|\{taxId\}|\{address\}|\{email\}|\{url\}/g, (m) => tokens[m] ?? m);
}

const today = new Date().toLocaleDateString(
  lang === "en" ? "en-GB" : lang === "ca" ? "ca-ES" : "es-ES",
  { year: "numeric", month: "long", day: "numeric" }
);

const metaDescription = `${content.title} · ${SITE.name}`;
---

<BaseLayout
  title={content.title}
  description={metaDescription}
  lang={lang}
  pageKey={pageKey}
  variant="doc"
  noindex={true}
>
  {/* The only pages in the site that scroll — legal text cannot be
      compressed into a slide without becoming useless. */}
  <div class="doc mx-auto max-w-3xl">
    <h1 class="text-statement font-medium">{content.title}</h1>
    <p class="micro mt-5 text-ink-mute">
      {content.updatedLabel}: {today}
    </p>

    <div class="divide-y divide-ink/12 border-t border-ink/12">
      {
        content.sections.map((s, i) => (
          <section class="grid gap-x-8 gap-y-2 py-8 md:grid-cols-[3rem_minmax(0,1fr)]">
            <p class="micro pt-1.5 text-primary-ink" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <div>
              {/* The index column already numbers the clause, so drop any
                  "1. " prefix the copy carries. */}
              <h2>{s.heading.replace(/^\d+\.\s*/, "")}</h2>
              {s.body.map((p) => (
                <p class="mt-3">{fill(p)}</p>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
