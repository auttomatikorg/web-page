---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import Section from "@/components/Section.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/config/site";
import type { Locale } from "@/config/site";
import { getLegal } from "@/i18n/content/legal";
import type { PageKey } from "@/i18n/utils";

interface Props {
  lang: Locale;
  doc: "legal" | "privacy" | "cookies";
}
const { lang, doc } = Astro.props;
const bundle = getLegal(lang);
const content = bundle[doc];
const pageKey = doc as PageKey;

const tokens: Record<string, string> = {
  "{company}": SITE.legal.companyName,
  "{taxId}": SITE.legal.taxId,
  "{address}": SITE.legal.address,
  "{email}": SITE.email,
  "{url}": SITE.url,
};

function fill(text: string): string {
  return text.replace(/\{company\}|\{taxId\}|\{address\}|\{email\}|\{url\}/g, (m) => tokens[m] ?? m);
}

const today = new Date().toLocaleDateString(
  lang === "en" ? "en-GB" : lang === "ca" ? "ca-ES" : "es-ES",
  { year: "numeric", month: "long", day: "numeric" }
);

const metaDescription = `${content.title} · ${SITE.name}`;
---

<BaseLayout
  title={content.title}
  description={metaDescription}
  lang={lang}
  pageKey={pageKey}
  noindex={true}
>
  <PageHero eyebrow={SITE.name} title={content.title} />

  <Section tone="white">
    <div class="mx-auto max-w-3xl">
      <p class="mb-2 text-sm text-ink-mute">
        {content.updatedLabel}: {today}
      </p>
      <p
        class="mb-10 flex items-start gap-3 rounded-2xl bg-primary/10 px-5 py-4 text-sm text-ink-soft"
      >
        <Icon name="lucide:info" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
        {content.reviewNote}
      </p>

      <div class="space-y-8">
        {
          content.sections.map((s) => (
            <div>
              <h2 class="text-xl font-semibold text-ink">{s.heading}</h2>
              {s.body.map((p) => (
                <p class="mt-3 leading-relaxed text-ink-soft">{fill(p)}</p>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</BaseLayout>
