---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  class?: string;
  type?: "button" | "submit";
  dataAttrs?: Record<string, string>;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
  dataAttrs = {},
  ariaLabel,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-medium font-display tracking-tight transition-all duration-200 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60";

const sizes = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-7 py-3.5 text-base",
};

const variants = {
  primary:
    "bg-primary text-white shadow-sm hover:bg-primary-dark hover:-translate-y-0.5 hover:shadow-md active:translate-y-0",
  secondary:
    "bg-transparent text-ink ring-1 ring-ink/20 hover:ring-ink/40 hover:bg-ink/5",
  ghost: "bg-transparent text-ink hover:bg-ink/5",
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel} {...dataAttrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} {...dataAttrs}>
      <slot />
    </button>
  )
}
