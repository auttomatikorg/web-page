---
interface Props {
  id?: string;
  tone?: "cream" | "white" | "creamDark" | "dark";
  class?: string;
  containerClass?: string;
}

const {
  id,
  tone = "cream",
  class: className = "",
  containerClass = "",
} = Astro.props;

const tones = {
  cream: "bg-cream-soft text-ink",
  white: "bg-white text-ink",
  creamDark: "bg-cream text-ink",
  dark: "bg-ink text-cream",
};
---

<section id={id} class={`py-20 md:py-28 ${tones[tone]} ${className}`}>
  <div class={`container-x ${containerClass}`}>
    <slot />
  </div>
</section>
