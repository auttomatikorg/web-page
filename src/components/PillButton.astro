---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  variant?: "solid" | "glass";
  size?: "md" | "lg";
  class?: string;
  external?: boolean;
}
const {
  href,
  variant = "glass",
  size = "md",
  class: className = "",
  external = false,
} = Astro.props;

/* Label + trailing circular arrow, as in the reference. White-on-orange only
   passes AA at large-bold, so the label never drops below 1.0625rem/600. */
const sizes = {
  md: "gap-3 py-1.5 pl-5 pr-1.5 text-[1.0625rem]",
  lg: "gap-4 py-2 pl-7 pr-2 text-[1.125rem]",
};
const knob = size === "lg" ? "h-11 w-11" : "h-10 w-10";

const variants = {
  solid:
    "bg-primary text-white shadow-[var(--shadow-ember)] hover:bg-primary-dark",
  glass:
    "glass text-ink hover:border-primary/40 hover:text-primary-ink",
};
const knobTone =
  variant === "solid"
    ? "bg-white/95 text-primary"
    : "bg-primary text-white";
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={`group/pill inline-flex items-center rounded-full font-semibold transition-[transform,background-color,border-color,color,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-0.5 ${sizes[size]} ${variants[variant]} ${className}`}
>
  <span><slot /></span>
  <span
    class={`grid shrink-0 place-items-center rounded-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/pill:rotate-45 ${knob} ${knobTone}`}
    aria-hidden="true"
  >
    <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
  </span>
</a>
