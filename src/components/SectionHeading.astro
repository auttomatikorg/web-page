---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  tone?: "light" | "dark";
  class?: string;
}
const {
  eyebrow,
  title,
  intro,
  align = "left",
  tone = "light",
  class: className = "",
} = Astro.props;

const alignCls = align === "center" ? "text-center mx-auto" : "";
const introColor = tone === "dark" ? "text-cream/80" : "text-ink-soft";
---

<div class={`max-w-2xl ${alignCls} ${className}`}>
  {
    eyebrow && (
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary">
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-3xl md:text-4xl lg:text-[2.6rem]">{title}</h2>
  {intro && <p class={`mt-4 text-lg leading-relaxed ${introColor}`}>{intro}</p>}
</div>
