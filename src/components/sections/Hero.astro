---
import Button from "@/components/Button.astro";
import { Icon } from "astro-icon/components";
import type { HomeContent } from "@/i18n/content/home";

interface Props {
  content: HomeContent["hero"];
  bookingHref: string;
  processHref: string;
}
const { content, bookingHref, processHref } = Astro.props;
---

<section class="relative overflow-hidden bg-cream-soft">
  <!-- Decorative background -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -right-32 -top-32 h-[36rem] w-[36rem] rounded-full bg-primary/15 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-24 h-[28rem] w-[28rem] rounded-full bg-primary/10 blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.4]"
      style="background-image: radial-gradient(circle, rgba(63,47,18,0.07) 1px, transparent 1px); background-size: 26px 26px;"
    >
    </div>
  </div>

  <div class="container-x relative py-24 md:py-32 lg:py-40">
    <div class="mx-auto max-w-4xl text-center">
      <p
        class="reveal mb-5 inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-medium text-ink-soft ring-1 ring-ink/10"
      >
        <span class="h-2 w-2 rounded-full bg-primary"></span>
        {content.eyebrow}
      </p>

      <h1
        class="reveal text-balance text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl lg:text-7xl"
      >
        {content.title}
      </h1>

      <p
        class="reveal mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl"
      >
        {content.subtitle}
      </p>

      <div
        class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <Button href={bookingHref} size="lg" variant="primary">
          {content.primaryCta}
          <Icon name="lucide:arrow-right" class="h-5 w-5" />
        </Button>
        <Button href={processHref} size="lg" variant="secondary">
          {content.secondaryCta}
        </Button>
      </div>

      <p class="reveal mt-5 text-sm text-ink-mute">{content.trustNote}</p>
    </div>
  </div>
</section>
