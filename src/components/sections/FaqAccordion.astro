---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { Icon } from "astro-icon/components";

interface Props {
  content: {
    eyebrow: string;
    title: string;
    intro: string;
    items: { q: string; a: string }[];
  };
}
const { content } = Astro.props;
---

<Section tone="white" id="faq">
  <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeading
        eyebrow={content.eyebrow}
        title={content.title}
        intro={content.intro}
      />
    </div>

    <div class="divide-y divide-ink/10">
      {
        content.items.map((item) => (
          <details class="faq-item group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-ink">
              <span>{item.q}</span>
              <Icon
                name="lucide:plus"
                class="h-5 w-5 shrink-0 text-primary transition-transform duration-300 group-open:rotate-45"
              />
            </summary>
            <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
