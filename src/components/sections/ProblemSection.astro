---
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { Icon } from "astro-icon/components";
import type { HomeContent } from "@/i18n/content/home";

interface Props {
  content: HomeContent["problem"];
}
const { content } = Astro.props;
---

<Section tone="white" id="problema">
  <SectionHeading
    eyebrow={content.eyebrow}
    title={content.title}
    intro={content.intro}
    align="center"
    class="mb-12"
  />

  <ul class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
    {
      content.thoughts.slice(0, 2).map((thought) => (
        <li class="reveal flex items-start gap-3 rounded-2xl bg-cream-soft p-5 ring-1 ring-ink/5">
          <Icon
            name="lucide:quote"
            class="mt-0.5 h-5 w-5 shrink-0 text-primary"
          />
          <p class="text-ink-soft italic">“{thought}”</p>
        </li>
      ))
    }
  </ul>

  <p class="reveal mx-auto mt-10 max-w-2xl text-center text-lg font-medium text-ink">
    {content.closing}
  </p>
</Section>
