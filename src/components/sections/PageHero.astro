---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-ink text-cream">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-primary/25 blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.5]"
      style="background-image: radial-gradient(circle, rgba(243,236,204,0.06) 1px, transparent 1px); background-size: 26px 26px;"
    >
    </div>
  </div>

  <div class="container-x relative py-20 md:py-28">
    <div class="max-w-3xl">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary-soft"
      >
        {eyebrow}
      </p>
      <h1 class="text-4xl font-semibold tracking-tight md:text-5xl lg:text-6xl">
        {title}
      </h1>
      {
        intro && (
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-cream/80 md:text-xl">
            {intro}
          </p>
        )
      }
    </div>
  </div>
</section>
