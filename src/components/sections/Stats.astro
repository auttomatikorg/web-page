---
import Section from "@/components/Section.astro";
import type { HomeContent } from "@/i18n/content/home";

interface Props {
  content: HomeContent["stats"];
}
const { content } = Astro.props;
---

<Section tone="dark" id="stats">
  <h2 class="reveal max-w-2xl text-2xl font-semibold text-cream md:text-3xl">
    {content.title}
  </h2>

  <dl class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      content.items.map((item) => (
        <div class="reveal border-l-2 border-primary/40 pl-5">
          <dt class="text-4xl font-semibold tracking-tight text-primary-soft md:text-5xl">
            {item.value}
          </dt>
          <dd class="mt-2 text-sm leading-relaxed text-cream/70">
            {item.label}
          </dd>
        </div>
      ))
    }
  </dl>

  <p class="reveal mt-10 text-sm text-cream/50">{content.note}</p>
</Section>
