---
import type { Locale } from "@/config/site";
import { route } from "@/i18n/utils";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const copy: Record<Locale, { text: string; accept: string; reject: string; more: string }> = {
  es: {
    text: "Usamos cookies propias y de terceros para mejorar tu experiencia y analizar el uso del sitio. La reserva de citas puede cargar contenido de terceros.",
    accept: "Aceptar",
    reject: "Rechazar",
    more: "Más información",
  },
  ca: {
    text: "Fem servir galetes pròpies i de tercers per millorar la teva experiència i analitzar l'ús del lloc. La reserva de cites pot carregar contingut de tercers.",
    accept: "Acceptar",
    reject: "Rebutjar",
    more: "Més informació",
  },
  en: {
    text: "We use first- and third-party cookies to improve your experience and analyse site usage. Booking a call may load third-party content.",
    accept: "Accept",
    reject: "Reject",
    more: "Learn more",
  },
};
const c = copy[lang];
---

<div
  id="cookie-banner"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-ink/12 bg-paper"
  role="dialog"
  aria-live="polite"
  aria-label="Cookies"
>
  <div
    class="flex flex-col gap-3 px-5 py-3 sm:flex-row sm:items-center sm:justify-between md:px-10"
  >
    <p class="micro max-w-2xl leading-relaxed text-ink-mute normal-case tracking-normal">
      {c.text}
      <a href={route("cookies", lang)} class="ml-1 text-primary-ink underline underline-offset-2">
        {c.more}
      </a>
    </p>
    <div class="flex shrink-0 gap-5">
      <button
        type="button"
        data-cookie="reject"
        class="micro underline underline-offset-2 text-ink-mute transition-colors hover:text-ink"
      >
        {c.reject}
      </button>
      <button
        type="button"
        data-cookie="accept"
        class="micro underline underline-offset-2 text-primary-ink transition-colors hover:text-primary"
      >
        {c.accept}
      </button>
    </div>
  </div>
</div>

<script>
  /* The banner is fixed, and a slide fills the viewport exactly — without
     reserving room for it the banner would sit on top of the bottom bar. */
  const KEY = "auttomatik-cookie-consent";

  const setup = () => {
    const banner = document.getElementById("cookie-banner");
    if (!banner) return;

    const show = !localStorage.getItem(KEY);
    banner.hidden = !show;
    document.documentElement.classList.toggle("has-cookie-banner", show);

    banner.querySelectorAll<HTMLButtonElement>("[data-cookie]").forEach((btn) => {
      btn.addEventListener("click", () => {
        localStorage.setItem(KEY, btn.dataset.cookie || "accept");
        banner.hidden = true;
        document.documentElement.classList.remove("has-cookie-banner");
      });
    });
  };

  document.addEventListener("astro:page-load", setup);
</script>
