---
interface Props {
  class?: string;
  tone?: "light" | "dark";
}
const { class: className = "", tone = "light" } = Astro.props;

const tones = {
  light: "bg-white ring-1 ring-ink/10 text-ink",
  dark: "bg-ink/40 ring-1 ring-cream/15 text-cream backdrop-blur",
};
---

<div
  class={`rounded-2xl p-6 md:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg ${tones[tone]} ${className}`}
>
  <slot />
</div>
